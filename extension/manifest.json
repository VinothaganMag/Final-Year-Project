{
  "manifest_version": 3,
  "name": "CRIS Link Guard",
  "version": "0.1.0",
  "description": "Intercepts external links and checks them with the local Cyber Risk Intelligence System before navigation.",
  "permissions": ["webNavigation", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5000/intercept*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "CRIS Link Guard"
  }
}
